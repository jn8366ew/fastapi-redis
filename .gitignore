docker-compose.override.yaml


# ─────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────
# redis-server 를 프로젝트 폴더에서 실행하면 지속화 파일이 여기에 생깁니다.
# 서버 상태 스냅샷이라 코드가 아니고, 실습 중 쌓인 키가 그대로 들어 있습니다.
dump.rdb
*.rdb
appendonly.aof
appendonlydir/
nodes.conf
redis-server.log


# ─────────────────────────────────────────────
#  프로젝트 (Cache-Aside 벤치마크)
# ─────────────────────────────────────────────
*.log
logs/

# 시드용 원본 데이터 (용량이 크면 커밋하지 않음)
data/raw/

# [주의] bench/results/ 는 커밋합니다.
#        결과를 리포에 남겨야 그래프를 언제든 재생성할 수 있고,
#        그것이 실험의 신뢰 근거가 됩니다. (docs/PLAN.md 12장)
bench/results/*.tmp
bench/results/**/*.partial

# 분석 산출물 중 중간 파일
*.pkl
.cache/
